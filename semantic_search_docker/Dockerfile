# USE THE SLIM PYTHON 3.11 IMAGE AS THE BASE IMAGE.
FROM python:3.11-slim

# SET THE APPLICATION WORKING DIRECTORY.
WORKDIR /app

# COPY THE DEPENDENCY FILE BEFORE THE APPLICATION CODE.
COPY requirements.txt .

# INSTALL THE REQUIRED PYTHON PACKAGES WITHOUT CACHING THEM.
RUN pip install --no-cache-dir -r requirements.txt

# COPY THE APPLICATION, MODEL, EMBEDDINGS, AND DATA INTO THE IMAGE.
COPY . .

# DOCUMENT THE PORT USED BY THE GRADIO APPLICATION.
EXPOSE 7860

# START THE GRADIO APPLICATION WHEN THE CONTAINER RUNS.
CMD ["python", "semantic_search_deploy.py"]